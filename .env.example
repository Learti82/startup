# Database
DATABASE_URL=postgresql://prona_user:prona_secret_2024@localhost:5432/prona_analyzer

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_in_production_jwt_secret_256bit

# Encryption key for documents (exactly 32 chars)
ENCRYPTION_KEY=change_me_in_production_32char!!

# Server
PORT=3001
NODE_ENV=development
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Anthropic AI (optional - uses mock analysis if not set)
ANTHROPIC_API_KEY=

# Email (optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
